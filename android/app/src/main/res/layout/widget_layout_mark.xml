<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_container"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_background_library" />

    <ImageView
        android:id="@+id/widget_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/diurnus_sunrise_mark"
            android:tint="#C49A52" />

        <TextView
            android:id="@+id/widget_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Diurnus"
            android:textColor="#F3EBDD"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
