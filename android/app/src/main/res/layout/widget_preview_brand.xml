<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_container"
    android:clipToOutline="true">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/widget_background_library" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="#7A000000" android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="60dp" android:layout_height="36dp" android:contentDescription="@null" android:scaleType="fitCenter" android:src="@drawable/diurnus_sunrise_mark" android:tint="#C49A52" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="serif" android:maxLines="1" android:text="Diurnus" android:textColor="#F3EBDD" android:textSize="28sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:maxLines="1" android:text="ONE REMARKABLE WORD EVERY DAY." android:textColor="#E6DED1" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
